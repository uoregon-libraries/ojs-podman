FROM docker.io/golang:1-alpine AS tps-build
WORKDIR /app
RUN apk add git make
RUN git clone -b v3.1.0 https://github.com/uoregon-libraries/turnstile-proxy-server.git .
RUN make

FROM docker.io/alpine AS tps
COPY --from=tps-build /app/bin/tps /usr/local/bin/tps

# TPS logs an error at startup if the custom templates dir doesn't exist, even
# though we don't use any
RUN mkdir -p /var/local/tps/data /var/local/tps/templates

# Settings that don't vary per environment
ENV GIN_MODE=release
ENV BIND_ADDR=:8080
ENV DB_PATH=/var/local/tps/data/tps.db

ENTRYPOINT ["/usr/local/bin/tps"]
CMD ["serve"]
