# Rootless podman user unit for the stack. It's a template so no host paths
# live in the repo: the instance name is the escaped path of the checkout,
# which %f turns back into the working directory. See "Running under systemd"
# in README.md.
#
#   systemctl --user enable --now "ojs@$(systemd-escape --path /path/to/ojs/prod).service"

[Unit]
Description=OJS (%f)
# Give up if it fails 3 times within a minute rather than thrashing forever
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
WorkingDirectory=%f
# podman compose hands off to podman-compose, which is often a pip/pipx
# install in ~/.local/bin, not on a user manager's default PATH
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# No service names: compose.yml's includes decide what runs, so the unit
# doesn't need editing when a service (e.g., scheduler) is added or removed
ExecStart=podman compose up
ExecStop=podman compose down
TimeoutStartSec=0
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
