#!/usr/bin/env php
<?php
// Prints an OJS config file with each "${VAR}" placeholder replaced by the
// value of environment variable VAR. Placeholders in comments are left alone.
//
// Nothing is printed, and the exit status is 1, if any placeholder can't be
// filled in safely: its var is unset or blank, has a line break, or has
// whitespace in an unquoted value (OJS would cut the value off there).
//
// OJS strips backslashes from quoted values, so those get escaped, e.g.,
// `password = "${MYSQL_PASSWORD}"` works for any password.

if ($argc != 2) {
    fwrite(STDERR, "Usage: render-config <config file>\n");
    exit(2);
}

$lines = file($argv[1]);
if ($lines === false) {
    exit(1);
}

$out = '';
$errors = [];
foreach ($lines as $i => $line) {
    if (str_starts_with(ltrim($line), ';') || !str_contains($line, '${')) {
        $out .= $line;
        continue;
    }

    // Same check OJS uses to decide a value is a quoted string
    $value = trim(explode('=', $line, 2)[1] ?? '');
    $quoted = preg_match('/^["\'].*["\']$/', $value);

    $out .= preg_replace_callback('/\$\{([A-Za-z_][A-Za-z0-9_]*)\}/', function ($m) use ($i, $quoted, &$errors) {
        $val = getenv($m[1]);
        $where = 'line ' . ($i + 1);
        if ($val === false || $val === '') {
            $errors[] = "$where: $m[1] is not set";
        } elseif (preg_match('/[\r\n]/', $val)) {
            $errors[] = "$where: $m[1] contains a line break";
        } elseif ($quoted) {
            return addslashes($val);
        } elseif (preg_match('/\s/', $val)) {
            $errors[] = "$where: $m[1] contains whitespace, so the value has to be in quotes";
        } else {
            return $val;
        }
        return $m[0];
    }, $line);
}

if ($errors) {
    fwrite(STDERR, "Can't fill in placeholders in $argv[1]:\n  " . implode("\n  ", $errors) . "\n");
    exit(1);
}
echo $out;
