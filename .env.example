# Copy this file to `.env` and edit.
#
# NOTE: Variables exported in your shell override these!
#
# The defaults here are for dev. Production will need most of these to be
# chosen more carefully.
#
# After changing anything here, run `up -d` so compose recreates the affected
# containers: a plain `restart` keeps the old values.

##
# Compose project
##

# Prefixes every container, network, and volume name (e.g., journals_db).
# Defaults to the checkout's directory name, so in production this *must be set
# to something meaningful*. Changing it later orphans the old volumes rather
# than renaming them.
COMPOSE_PROJECT_NAME=journals

##
# Container logs
##

# Where each service writes its stdout/stderr (web.log, proxy.log, etc.). It
# must be absolute (use ${PWD}/..., not ./...), and it must already exist. On
# prod, it should be outside the checkout and rotated by the host. See
# docs/container-logs.md.
CONTAINER_LOG_DIR=${PWD}/logs

##
# Public URL
##

# The URL people use to reach the site, in pieces so other settings can reuse
# them. PUBLIC_SCHEME must be "http" or "https".
PUBLIC_SCHEME=http
PUBLIC_HOST=localhost

# The URL's port, *including* the colon. Leave it blank if the URL doesn't
# have one (e.g., https on port 443).
PUBLIC_PORT_SUFFIX=:8080

# Built from the above, so you shouldn't need to edit it
PUBLIC_URL=${PUBLIC_SCHEME}://${PUBLIC_HOST}${PUBLIC_PORT_SUFFIX}

##
# Database
##

# DB credentials are used in several services, all shared from these settings.
# Stick to letters and numbers in the password due to our hacky
# podman-mysqldump.sh script.
MYSQL_HOST=db
MYSQL_DATABASE=ojs
MYSQL_USER=ojs
MYSQL_PASSWORD=ojs

# Only the "db" service uses this. Ignored with an external database.
MYSQL_ROOT_PASSWORD=root_password

##
# OJS config placeholders
##

# OJS doesn't read the environment, so on startup we fill in any "${VAR}"
# placeholders in config.inc.php with these (DB values share the MYSQL_* vars).
# Our base config uses all of them, so OJS won't start until they're set. (A
# var can be blank if you take its placeholder out of your config.) See
# "Config" in README.md.

# "Off" until the web installer has set up the database, then "On". A site
# whose database is already set up (e.g., a migration from another server)
# starts at "On".
OJS_INSTALLED=Off

# A JSON list of the hostnames OJS answers to. Add any others people use, e.g.,
# ["${PUBLIC_HOST}", "127.0.0.1"].
OJS_ALLOWED_HOSTS=["${PUBLIC_HOST}"]

# The OAI repository ID. It's in every record ID OJS gives harvesters, so on a
# live site it must never change, even if PUBLIC_HOST does (hard-code the old
# value instead). This default is what OJS's installer would pick.
OJS_OAI_REPOSITORY_ID=ojs2.${PUBLIC_HOST}

# Secrets. On an existing site, copy these from its config.inc.php: changing
# them breaks things like API keys and password reset links that are already
# out there. For a new site:
#
# - OJS_APP_KEY: `echo "base64:$(openssl rand -base64 32)"`
# - OJS_SALT and OJS_API_KEY_SECRET: long random strings, e.g., from
#   `openssl rand -hex 32`
OJS_APP_KEY=
OJS_SALT=
OJS_API_KEY_SECRET=

# The mail server. "smtpdebug" is the dev mail catcher (smtpdebug.compose.yml),
# which must never be used in production.
OJS_SMTP_SERVER=smtpdebug
OJS_SMTP_PORT=25

# Where bounces go when a journal doesn't set its own bounce address
OJS_ENVELOPE_SENDER=nobody@smtpdebug.example.org

##
# Proxy (Caddy)
##

# Space-separated IPs / CIDR ranges of any proxies in front of this stack that
# *aren't* on a private network, so Caddy trusts the client IP they send.
# Private ranges are always trusted.
EXTRA_TRUSTED_PROXIES=

##
# TPS secrets. You have to set these manually or the stack refuses to start.
# They don't have dev defaults because of the damage bad values can do in
# production.
##

# Cloudflare keys come from a Turnstile widget in your Cloudflare dashboard, or
# use test keys (see below)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Signs the cookie TPS hands out after a challenge. Choose a long, random value:
# a bot that figures it out can skip TPS entirely.
JWT_SIGNING_KEY=

# Optional: enables TPS's /.tps/report page for people who know this secret
ADMIN_SECRET=

###
# Cloudflare test keys, from
# <https://developers.cloudflare.com/turnstile/troubleshooting/testing/>.
# Remove the comment at the end if you copy and paste, otherwise that becomes
# part of the value.
###
#TURNSTILE_SITE_KEY=1x00000000000000000000AA # Always passes, visible
#TURNSTILE_SITE_KEY=2x00000000000000000000AB # Always fails, visible
#TURNSTILE_SITE_KEY=1x00000000000000000000BB # Always passes, invisible
#TURNSTILE_SITE_KEY=2x00000000000000000000BB # Always fails, invisible
#TURNSTILE_SITE_KEY=3x00000000000000000000FF # Force interactive challenge, visible
#TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA # Always passes validation
#TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA # Always fails validation
